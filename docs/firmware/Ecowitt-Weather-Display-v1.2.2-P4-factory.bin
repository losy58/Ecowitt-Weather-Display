]+j.ssid+T[2]+j.ip;return;}if(j.state==3){h.textContent=T[3];m.textContent=T[4]+j.ssid+' ('+j.ip+').';return;}m.textContent=T[5]+s+T[6];setTimeout(poll,2000);}).catch(function(){if(s>90){h.textContent=T[7];m.textContent=T[8];return;}m.textContent=T[9]+s+T[6];setTimeout(poll,2000);});}setTimeout(poll,3000);</script></body></html>␀␀␀wrong password␀␀hibÃ¡s jelszÃ³␀␀Firmware update␀Do not switch off the device!␀␀␀Firmware frissÃ­tÃ©s␀␀␀␀Ne kapcsold ki a kÃ©szÃ¼lÃ©ket!␀ feltÃ¶ltve␀ uploaded␀␀␀the upload was interrupted␀␀megszakadt a feltÃ¶ltÃ©s␀␀␀␀%u KB%s␀%d %%  (%u / %u KB)␀KijelzÅ‘ indÃ­tÃ¡sa (JC8012P4A1C)␀␀␀Outdoor: %.1f Â°C␀␀␀Kint: %.1f Â°C␀␀Humidity: %.0f %%␀␀␀PÃ¡ratartalom: %.0f %%␀␀Wind: %.1f km/h␀SzÃ©l: %.1f km/h␀␀␀␀Direction: %.0fÂ° %s␀␀␀␀IrÃ¡ny: %.0fÂ° %s␀␀␀Avg direction: %.0fÂ° %s␀␀␀␀ÃtlagirÃ¡ny: %.0fÂ° %s␀Gust: %.1f km/h␀LÃ¶kÃ©s: %.1f km/h␀␀Daily max: %.1f km/h␀␀␀␀Napi max: %.1f km/h␀Raining: %s␀Esik: %s␀␀␀␀igen␀␀␀␀nem␀no␀␀yes␀Rate: %.1f mm/h␀IntenzitÃ¡s: %.1f mm/h␀␀Event: %.1f mm␀␀EsemÃ©ny: %.1f mm␀␀␀Hourly rain: %.1f mm␀␀␀␀Ã“rÃ¡s esÅ‘: %.1f mm␀␀␀␀Daily rain: %.1f mm␀Napi esÅ‘: %.1f mm␀␀24h rain: %.1f mm␀␀␀24 Ã³rÃ¡s esÅ‘: %.1f mm␀Weekly rain: %.1f mm␀␀␀␀Heti esÅ‘: %.1f mm␀␀Monthly rain: %.1f mm␀␀␀Havi esÅ‘: %.1f mm␀␀Yearly rain: %.1f mm␀␀␀␀Ã‰ves esÅ‘: %.1f mm␀Solar: %.0f W/mÂ²␀␀␀SugÃ¡rzÃ¡s: %.0f W/mÂ²␀␀Pressure: %.1f hPa␀␀NyomÃ¡s: %.1f hPa␀␀␀no CO2 sensor␀␀␀nincs CO2-mÃ©rÃ©s␀␀␀WS90 battery: %.2f V␀␀␀␀WS90 akku: %.2f V␀␀␀%s: %.2f V␀␀%s akku: %.2f V␀Uptime: %u d %u h␀␀␀FutÃ¡sidÅ‘: %u nap %u Ã³␀␀␀␀Capacitor: %.1f V␀␀␀KondenzÃ¡tor: %.1f V␀␀␀␀VPD: %.2f kPa␀␀␀UV index: %.0f␀␀Abs.: %.1f hPa␀␀%s: %.1fÂ° %.0f%%␀␀␀%s: --␀␀CO2 (ppm)␀␀␀%s: %.0f␀␀␀␀%s: %.0f ppm␀␀␀␀%s | %.0fs | fw %.0f␀␀␀␀diag␀␀␀␀boots␀␀␀KijelzÅ‘ HIBA - ÃºjraindÃ­tÃ¡s␀␀KijelzÅ‘ HIBA - a webes kezelÅ‘oldal ettÅ‘l mÃ©g mÅ±kÃ¶dik␀␀LVGL puffer: PSRAM, %d sor
