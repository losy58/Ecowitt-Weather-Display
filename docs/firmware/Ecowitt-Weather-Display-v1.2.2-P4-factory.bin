getElementById('tzs'),t=document.getElementById('tz');var p1=document.getElementById('newpw'),p2=document.getElementById('newpw2');document.getElementById('chpw').onchange=function(){p1.disabled=p2.disabled=!this.checked;};p1.closest('form').onsubmit=function(){if(!p1.disabled&&p1.value!==p2.value){alert(L[0]);return false;}};s.onchange=function(){if(s.value)t.value=s.value;};function get(u){var c=new AbortController(),tm=setTimeout(function(){c.abort();},8000);return fetch(u,{signal:c.signal}).then(function(x){clearTimeout(tm);return x.json();});}function ipwho(){return get('https://ipwho.is/?fields=success,latitude,longitude,city,timezone').then(function(j){if(!j.success)throw 0;return{lat:j.latitude,lon:j.longitude,city:j.city,tz:j.timezone&&j.timezone.id};});}function ipapi(){return get('http://ip-api.com/json/?fields=status,lat,lon,city,timezone').then(function(j){if(j.status!=='success')throw 0;return{lat:j.lat,lon:j.lon,city:j.city,tz:j.timezone};});}document.getElementById('ipb').onclick=function(){var r=document.getElementById('ipr');r.textContent=L[1];ipwho().catch(ipapi).then(function(j){document.getElementById('lat').value=j.lat.toFixed(4);document.getElementById('lon').value=j.lon.toFixed(4);r.textContent=L[2]+j.city+' ('+j.tz+')'+L[3];for(var i=0;i<s.options.length;i++){if(s.options[i].dataset.iana===j.tz){s.selectedIndex=i;t.value=s.value;}}}).catch(function(){r.textContent=L[4];});};</script>␀␀<form id='f' method='POST' enctype='multipart/form-data'><input type='file' name='firmware' accept='.bin' required><button type='submit'>␀␀␀</button></form><script>document.getElementById('f').onsubmit=function(){this.action='/update?size='+this.firmware.files[0].size;};</script><script>document.querySelectorAll('form').forEach(function(f){f.addEventListener('submit',function(e){setTimeout(function(){if(e.defaultPrevented)return;var b=f.querySelector('button[type=submit]');if(b){b.textContent='␀';b.disabled=true;}},0);});});</script></body></html>␀␀␀":[␀null␀␀␀